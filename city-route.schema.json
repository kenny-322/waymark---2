{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waymark.invalid/schemas/city-route.schema.json",
  "title": "WAY●MARK City Route Draft",
  "description": "План посещения мест внутри одного города. В версии 1.32 хранит порядок остановок; геометрия реального маршрута по улицам подключается отдельным маршрутизатором.",
  "type": "object",
  "required": ["schemaVersion", "id", "cityId", "mode", "stops"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "cityId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "mode": {
      "type": "string",
      "enum": ["walking", "cycling", "driving", "transit"],
      "description": "Целевой вид передвижения для будущего маршрутизатора. Само поле ещё не означает, что роутинг этого типа подключён."
    },
    "stops": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["placeId", "order"],
        "properties": {
          "placeId": { "type": "string", "minLength": 1 },
          "order": { "type": "integer", "minimum": 0 },
          "coordinates": {
            "type": "object",
            "required": ["lat", "lon"],
            "properties": {
              "lat": { "type": "number", "minimum": -90, "maximum": 90 },
              "lon": { "type": "number", "minimum": -180, "maximum": 180 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
