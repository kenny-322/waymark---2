{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waymark.invalid/schemas/city-place.schema.json",
  "title": "WAY●MARK City Place",
  "description": "Точка интереса на подробной городской карте: достопримечательность, кафе, парк, отель и т. п.",
  "type": "object",
  "required": ["schemaVersion", "id", "cityId", "name", "category", "coordinates"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "cityId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "category": {
      "type": "string",
      "enum": ["attraction", "museum", "restaurant", "cafe", "hotel", "park", "transport", "viewpoint", "shopping", "other"]
    },
    "coordinates": {
      "type": "object",
      "required": ["lat", "lon"],
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 }
      },
      "additionalProperties": false
    },
    "description": { "type": "string" },
    "address": { "type": "string" },
    "website": { "type": "string", "format": "uri" },
    "sourceName": { "type": "string" },
    "sourceUrl": { "type": "string", "format": "uri" },
    "priceInfo": { "type": "string", "description": "Только проверенная или явно обозначенная приблизительная информация." },
    "openingHours": { "type": "string", "description": "Локальное время и источник данных должны быть понятны пользователю." }
  },
  "additionalProperties": false
}
