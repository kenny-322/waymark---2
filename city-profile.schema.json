{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waymark.invalid/schemas/city-profile.schema.json",
  "title": "WAY●MARK City Profile",
  "description": "Целевой формат подробной информации о городе. Данные загружаются, когда пользователь открывает профиль.",
  "type": "object",
  "required": ["schemaVersion", "id", "description", "languages", "currency", "timezone", "attractions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "description": { "type": "string" },
    "languages": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "timezone": { "type": "string", "minLength": 1 },
    "climate": { "type": "string" },
    "cuisine": { "type": "array", "items": { "type": "string" } },
    "bestTime": { "type": "string" },
    "attractions": {
      "type": "array",
      "items": { "$ref": "#/$defs/attraction" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "attraction": {
      "type": "object",
      "required": ["id", "name", "description"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "category": { "type": "string", "minLength": 1 },
        "coordinates": { "$ref": "#/$defs/coordinates" }
      },
      "additionalProperties": false
    },
    "coordinates": {
      "type": "object",
      "required": ["lat", "lon"],
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 }
      },
      "additionalProperties": false
    }
  }
}
